    {"name": "pve-00 plan (full, check)", "job_type": "check", "skip_tags": "terraform-credentials,monitoring-credentials"},
    {"name": "pve-00 updates (check)", "job_type": "check", "job_tags": "updates"},
    {"name": "pve-00 updates (APPLY)", "job_type": "run", "job_tags": "updates"}
  ],
  "workflow": "pve-00 updates (gated)",
  "approval": "Review the updates check output, then approve"
}
