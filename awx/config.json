{
  "organization": "Default",
  "inventory": "pve",
  "group": "pve",
  "host": "pve-00",
  "host_variables": {
    "ansible_host": "10.0.40.10",
    "ansible_ssh_common_args": "-o UserKnownHostsFile=/dev/null -o StrictHostKeyChecking=yes -o \"KnownHostsCommand=/bin/echo 10.0.40.10 ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIEe4igb/fQB5ujUc53Nivn1FjaN59XHW5iL2+ayEs+d3\""
  },
  "project": {
    "name": "home-dc-proxmox",
    "scm_type": "git",
    "scm_url": "https://github.com/fabricesemti80/home-dc-proxmox.git",
    "scm_branch": "main",
    "scm_update_on_launch": true
  },
  "execution_environment": {
    "name": "home-dc-proxmox EE",
    "image": "ghcr.io/fabricesemti80/home-dc-proxmox-awx-ee@sha256:0f146cf078a7447b3363772736ebb34f36b797fea7df07014d816f91e350a7e5",
    "pull": "missing"
  },
  "machine_credential": "pve-00 root (AWX)",
