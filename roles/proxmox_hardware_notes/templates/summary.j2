{#- At-a-glance hardware summary, rendered from Ansible facts plus hardware_inventory.py output. ASCII only. -#}
{% set ns = namespace(rows=[]) %}
{% for name, disk in ansible_facts['devices'].items() if name is match('^(sd[a-z]+|vd[a-z]+|nvme[0-9]+n[0-9]+)$') and (disk.sectors | int) > 0 %}
{%   set bytes = (disk.sectors | int) * (disk.sectorsize | default(512) | int) %}
{%   set size = ('%.1f TB' | format(bytes / 1000000000000)) if bytes >= 1000000000000 else ('%d GB' | format(bytes / 1000000000)) %}
{%   set media = 'NVMe' if name is match('^nvme') else ('HDD' if (disk.rotational | default('0')) == '1' else 'SSD') %}
{%   set use = hardware_notes_hw.usage.get(name, {}) %}
{%   if use.get('vms') %}
{%     set vm_text = namespace(items=[]) %}
{%     for vm in use.vms %}
{%       set vm_text.items = vm_text.items + ['VM ' ~ vm.vmid ~ ' ' ~ vm.vm ~ ' (' ~ vm.iface ~ ')'] %}
{%     endfor %}
{%     set role = 'passed through to ' ~ (vm_text.items | join(', ')) %}
{%   elif use.get('zfs') %}
{%     set role = 'host ZFS pool ' ~ use.zfs.pool ~ ((' (storage ' ~ (use.zfs.storages | join(', ')) ~ ')') if use.zfs.storages else '') %}
{%   elif use.get('mounts') %}
{%     set role = 'host, mounted at ' ~ (use.mounts | join(', ')) %}
{%   elif use.get('swap') %}
{%     set role = 'host swap' %}
{%   else %}
{%     set plan = namespace(vm='') %}
{%     for p in (hardware_notes_ssd_plan | default({})).get('proxmox_ssd_passthrough_disks', []) %}
{%       if (p.by_id | basename) in (disk.links.ids | default([])) %}
{%         set plan.vm = 'VM ' ~ p.vmid ~ ' ' ~ p.vm_name %}
{%       endif %}
{%     endfor %}
{%     set role = ('reserved for ' ~ plan.vm ~ ' (not attached yet)') if plan.vm else 'unused' %}
{%   endif %}
{%   set label = (disk.model or 'unknown disk') | trim %}
{%   set ns.rows = ns.rows + [{'sort': role ~ label, 'text': '  %-26s %8s %-5s -> %s' | format(label, size, media, role)}] %}
{% endfor %}
{{ ansible_facts['hostname'] }} hardware at a glance (generated by Ansible - do not edit)

GPU
{% for gpu in hardware_notes_hw.gpus | sort(attribute='address') %}
{%   if gpu.driver == 'vfio-pci' %}
{%     set gpu_vms = namespace(items=[]) %}
{%     for vm in gpu.vms %}
{%       set gpu_vms.items = gpu_vms.items + ['VM ' ~ vm.vmid ~ ' ' ~ vm.vm] %}
{%     endfor %}
  {{ '%-28s' | format(gpu.name) }} -> passed through (vfio-pci){{ (' to ' ~ (gpu_vms.items | join(', '))) if gpu_vms.items else '' }}
{%   else %}
  {{ '%-28s' | format(gpu.name) }} -> used by the host ({{ gpu.driver if gpu.driver else 'no driver' }})
{%   endif %}
{% else %}
  none detected
{% endfor %}

STORAGE
{% for row in ns.rows | sort(attribute='sort') %}
{{ row.text }}
{% else %}
  none detected
{% endfor %}
